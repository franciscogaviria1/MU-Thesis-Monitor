# Optional. Enables live MU market data; failures show an unavailable state.
ALPHA_VANTAGE_API_KEY=

# Optional. Enables user-initiated, server-only explanation requests.
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=gpt-5-mini

# Optional. Defaults to ./data/mu-thesis-monitor.sqlite.
MU_PERSISTENCE_PATH=
